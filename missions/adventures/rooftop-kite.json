        "message:kitePatched"
      ]
    },
    {
      "when": "click:kite",
      "in": "workshop",
      "actions": [
        "message:kiteTorn"
      ]
    },
    {
      "when": "click:paper",
      "in": "workshop",
      "if": "!patched+!inventory.paper",
      "actions": [
        "inventory:paper",
        "sound:paper",
        "message:paperTaken"
      ]
    },
    {
      "when": "click:paper",
      "in": "workshop",
      "if": "inventory.paper",
      "actions": [
        "select:paper",
        "message:paperTaken"
      ]
    },
    {
      "when": "click:spool",
      "in": "workshop",
      "if": "!tied+!inventory.spool",
      "actions": [
        "inventory:spool",
        "sound:paper",
        "message:threadTaken"
      ]
    },
    {
      "when": "click:spool",
      "in": "workshop",
      "if": "inventory.spool",
      "actions": [
        "select:spool",
        "message:threadTaken"
      ]
    },
    {
      "when": "drop:paper:kite",
      "in": "workshop",
      "if": "!patched",
      "actions": [
        "flag:patched",
        "hide:paper",
        "remove:paper",
        "sound:paper",
        "message:kitePatched"
      ]
    },
    {
      "when": "drop:spool:kite",
      "in": "workshop",
      "if": "!patched",
      "actions": [
        "message:needPatch"
      ]
    },
    {
      "when": "drop:spool:kite",
      "in": "workshop",
      "if": "patched+!tied",
      "actions": [
        "flag:tied",
        "hide:spool",
        "remove:spool",
        "sound:tie",
        "message:kiteTied"
      ]
    },
    {
      "when": "click:roofDoor",
      "in": "workshop",
      "actions": [
        "scene:rooftop"
      ]
    },
    {
      "when": "click:stairs",
      "in": "rooftop",
      "actions": [
        "scene:workshop"
      ]
    },
    {
      "when": "click:kite",
      "in": "rooftop",
      "if": "tied",
      "actions": [
        "select:kite",
        "message:roofKite"
      ]
    },
    {
      "when": "click:kite",
      "in": "rooftop",
      "actions": [
        "message:stillBroken"
      ]
    },
    {
      "when": "drop:kite:launchPad",
      "in": "rooftop",
      "if": "!tied",
      "actions": [
        "message:needString"
      ]
    },
    {
      "when": "drop:kite:launchPad",
      "in": "rooftop",
      "if": "tied+!positioned",
      "actions": [
        "flag:positioned",
        "sound:tie",
        "message:launchPadReady"
      ]
    },
    {
      "when": "drop:kite:launchPad",
      "in": "rooftop",
      "if": "positioned",
      "actions": [
        "message:launchPadReady"
      ]
    },
    {
      "when": "click:launchPad",
      "in": "rooftop",
      "if": "positioned",
      "actions": [
        "message:launchPadReady"
      ]
    },
    {
      "when": "click:launchPad",
      "in": "rooftop",
      "actions": [
        "message:launchPadEmpty"
      ]
    },
    {
      "when": "click:weatherVane",
      "in": "rooftop",
      "if": "positioned",
      "actions": [
        "message:windQuestion"
      ]
    },
    {
      "when": "click:weatherVane",
      "in": "rooftop",
      "actions": [
        "message:windBefore"
      ]
    },
    {
      "when": "choose:west",
      "in": "rooftop",
      "if": "positioned",
      "actions": [
        "sound:gust",
        "message:badWind"
      ]
    },
    {
      "when": "choose:east",
      "in": "rooftop",
      "if": "positioned",
      "actions": [
        "flag:steady",
        "sound:gentle",
        "message:goodWind"
      ]
    },
    {
      "when": "click:launch",
      "in": "rooftop",
      "if": "tied+positioned+steady",
      "actions": [
        "sound:launch",
        "cutscene:kiteFlight",
        "ending:complete"
      ]
    },
    {
      "when": "navigate:workshop",
      "in": "rooftop",
      "actions": [
        "scene:workshop"
      ]
    },
    {
      "when": "navigate:rooftop",
      "in": "workshop",
      "actions": [
        "scene:rooftop"
      ]
    },
    {
      "when": "enter:rooftop",
      "if": "!tied",
      "actions": [
        "message:roofEarly"
      ]
    },
    {
      "when": "enter:rooftop",
      "actions": [
        "message:roofWelcome"
      ]
    },
    {
      "when": "enter:workshop",
      "if": "tied",
      "actions": [
        "message:kiteReadyInShop"
      ]
    },
    {
      "when": "enter:workshop",
      "actions": [
        "message:firstHint"
      ]
    }
  ],
