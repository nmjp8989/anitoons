  "dialogues": {
    "intro": {
      "text": "Our reading picnic is nearly ready. But the big moon lantern is missing! Let’s follow the clues. No need to hurry.",
      "speaker": "harpreet"
    },
    "kabirHello": {
      "text": "I saw something blue flutter past the gate. Was it a tiny dragon? We should check the clues before we guess!",
      "speaker": "kabir",
      "choices": [
        {
          "label": "Look at the footprint trails",
          "event": "click:footprints"
        },
        {
          "label": "Check the ribbon pattern",
          "event": "click:bunting"
        }
      ]
    },
    "meenaHello": {
      "text": "I moved a lantern out of the breeze so it would stay safe. Then I forgot to leave a note! The plant labels will show you where.",
      "speaker": "meena"
    },
    "cantCombine": {
      "text": "That is a useful clue. Keep it in your pocket and look around. Use the notebook to see how the clues fit together.",
      "speaker": "harpreet"
    },
    "saveResume": {
      "text": "Welcome back, detective. Your clues are safe. Open the notebook if you want to remember what we found.",
      "speaker": "harpreet"
    },
    "gateBlocked": {
      "text": "We need three clues: the ribbon colour, the kind of flower, and the plant number. The notebook will help.",
      "speaker": "harpreet"
    },
    "needSnacks": {
      "text": "We found the lantern! Let’s collect twelve snacks from the reading room before we start the picnic.",
      "speaker": "harpreet"
    },
    "needLantern": {
      "text": "First, take a look at the moon lantern. How did it get here?",
      "speaker": "harpreet"
    },
    "lanternFound": {
      "text": "There it is, safe beside the moonflowers! A blue ribbon, a moonflower petal, and plant number 13. All our clues fit.",
      "speaker": "harpreet"
    },
    "meenaSorry": {
      "text": "The breeze tugged at its ribbon. I brought it here to keep it safe. I’m sorry I forgot the note.",
      "speaker": "meena"
    },
    "kabirEnd": {
      "text": "So nobody took it! And the greenhouse is a lovely place for a reading picnic. Can I sit by the moonflowers?",
      "speaker": "kabir"
    },
    "picnicEnd": {
      "text": "Twelve snacks for all of us, one rescued lantern, and a story to share. Good detectives count carefully and ask kindly.",
      "speaker": "harpreet"
    },
    "alreadyShared": {
      "text": "Our picnic is ready. Everyone has a place beside the lantern.",
      "speaker": "harpreet"
    },
    "deduction": {
      "text": "The blue ribbon, moonflower petal and number 13 all match. Where should we look?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "The greenhouse, beside plant 13",
          "event": "solve:deduction"
        },
        {
          "label": "The street outside",
          "event": "guess:street"
        },
        {
          "label": "The reading-room cupboard",
          "event": "guess:cupboard"
        }
      ]
    },
    "deductionRetry": {
      "text": "Let’s use all three clues together: blue ribbon, moonflowers, and plant 13. Where can we find all three?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "The greenhouse, beside plant 13",
          "event": "solve:deduction"
        },
        {
          "label": "The street outside",
          "event": "guess:street"
        },
        {
          "label": "The reading-room cupboard",
          "event": "guess:cupboard"
        }
      ]
    },
    "gateOpen": {
      "text": "The gate opens onto a warm little greenhouse. Let’s see if our idea was right.",
      "speaker": "harpreet"
    },
    "flowersDone": {
      "text": "Six plus six is twelve. Meena smiles: “Just right for our picnic!”",
      "speaker": "harpreet"
    },
    "hooks": {
      "text": "Ten hooks, six little lanterns. How many hooks are empty?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "3 empty hooks",
          "event": "answer:hooks:0"
        },
        {
          "label": "4 empty hooks",
          "event": "answer:hooks:1"
        },
        {
          "label": "6 empty hooks",
          "event": "answer:hooks:2"
        }
      ],
      "puzzle": "hooks"
    },
    "hooksHelp": {
      "text": "Let’s look together. Count each empty hook once. Or start at six and count on to ten: seven, eight, nine, ten.",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "3 empty hooks",
          "event": "answer:hooks:0"
        },
        {
          "label": "4 empty hooks",
          "event": "answer:hooks:1"
        },
        {
          "label": "6 empty hooks",
          "event": "answer:hooks:2"
        }
      ],
      "puzzle": "hooks"
    },
    "hooksDone": {
      "text": "Six lanterns and four empty hooks make ten. A blue ribbon is caught on the last hook. A clue!",
      "speaker": "harpreet"
    },
    "snacks": {
      "text": "There are seven apple slices and five crackers. How many snacks altogether?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "11 snacks",
          "event": "answer:snacks:0"
        },
        {
          "label": "13 snacks",
          "event": "answer:snacks:1"
        },
        {
          "label": "12 snacks",
          "event": "answer:snacks:2"
        }
      ],
      "puzzle": "snacks"
    },
    "snacksHelp": {
      "text": "Let’s look together. Touch each snack to count it. Start at seven and count five more: eight, nine, ten, eleven, twelve.",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "11 snacks",
          "event": "answer:snacks:0"
        },
        {
          "label": "13 snacks",
          "event": "answer:snacks:1"
        },
        {
          "label": "12 snacks",
          "event": "answer:snacks:2"
        }
      ],
      "puzzle": "snacks"
    },
    "snacksDone": {
      "text": "Seven plus five is twelve. The picnic snacks are packed. Let’s take them along!",
      "speaker": "harpreet"
    },
    "trails": {
      "text": "The long trail has fourteen prints. The short trail has twelve. Which trail has more?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "14 — toward the moonflowers",
          "event": "answer:trails:0"
        },
        {
          "label": "12 — toward the street",
          "event": "answer:trails:1"
        },
        {
          "label": "They have the same number",
          "event": "answer:trails:2"
        }
      ],
      "puzzle": "trails"
    },
    "trailsHelp": {
      "text": "Let’s look together. Compare the matching pairs of prints. The trail with fourteen has two left over.",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "14 — toward the moonflowers",
          "event": "answer:trails:0"
        },
        {
          "label": "12 — toward the street",
          "event": "answer:trails:1"
        },
        {
          "label": "They have the same number",
          "event": "answer:trails:2"
        }
      ],
      "puzzle": "trails"
    },
    "trailsDone": {
      "text": "Fourteen is more than twelve. The longer trail leads to the moonflowers. Here is a fallen moonflower petal!",
      "speaker": "harpreet"
    },
    "ribbons": {
      "text": "Blue, gold, blue, gold, blue… Which ribbon colour comes next?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "Blue ribbon",
          "event": "answer:ribbons:0"
        },
        {
          "label": "Gold ribbon",
          "event": "answer:ribbons:1"
        },
        {
          "label": "Green ribbon",
          "event": "answer:ribbons:2"
        }
      ],
      "puzzle": "ribbons"
    },
    "ribbonsHelp": {
      "text": "Let’s look together. Say the repeating part: blue, gold. After blue comes gold.",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "Blue ribbon",
          "event": "answer:ribbons:0"
        },
        {
          "label": "Gold ribbon",
          "event": "answer:ribbons:1"
        },
        {
          "label": "Green ribbon",
          "event": "answer:ribbons:2"
        }
      ],
      "puzzle": "ribbons"
    },
    "ribbonsDone": {
      "text": "Gold comes next. This ribbon line repeats blue, gold. Our loose blue ribbon matches the greenhouse decorations!",
      "speaker": "harpreet"
    },
    "labels": {
      "text": "The plant labels read eleven, twelve, a missing number, fourteen. Which number is missing?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "15",
          "event": "answer:labels:0"
        },
        {
          "label": "10",
          "event": "answer:labels:1"
        },
        {
          "label": "13",
          "event": "answer:labels:2"
        }
      ],
      "puzzle": "labels"
    },
    "labelsHelp": {
      "text": "Let’s look together. Count forward one at a time: eleven, twelve, thirteen, fourteen.",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "15",
          "event": "answer:labels:0"
        },
        {
          "label": "10",
          "event": "answer:labels:1"
        },
        {
          "label": "13",
          "event": "answer:labels:2"
        }
      ],
      "puzzle": "labels"
    },
    "labelsDone": {
      "text": "Thirteen! This tag belongs beside the moonflowers in the greenhouse. Keep it as our last clue.",
      "speaker": "harpreet"
    },
    "flowers": {
      "text": "Six flowers in this basket and six in that one. How many flowers altogether?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "10 flowers",
          "event": "answer:flowers:0"
        },
        {
          "label": "12 flowers",
          "event": "answer:flowers:1"
        },
        {
          "label": "14 flowers",
          "event": "answer:flowers:2"
        }
      ],
      "puzzle": "flowers"
    },
    "flowersHelp": {
      "text": "Let’s look together. Count six flowers, then six more. Or make ten first: six and four make ten, then add two.",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "10 flowers",
          "event": "answer:flowers:0"
        },
        {
          "label": "12 flowers",
          "event": "answer:flowers:1"
        },
        {
          "label": "14 flowers",
          "event": "answer:flowers:2"
        }
      ],
      "puzzle": "flowers"
    }
  },
  "rules": [
    {
      "when": "click:lanterns",
      "actions": [
        "message:hooksDone"
      ],
      "in": "home",
