  "dialogues": {
    "intro": {
      "text": "One last parcel. The rain has blurred the address, and whoever sent it wrote: before the lights go out.",
      "speaker": "harpreet"
    },
    "note": {
      "text": "A handwritten note: keep this dry. Tonight, a whole neighbourhood is counting on one little light.",
      "speaker": "harpreet"
    },
    "parcelTaken": {
      "text": "Still warm inside. But the label is soaked. Better dry it gently, without opening the parcel.",
      "speaker": "harpreet"
    },
    "lamp": {
      "text": "A warm desk lamp. Good for drying something delicate.",
      "speaker": "harpreet"
    },
    "labelDry": {
      "text": "There it is. The Old Picture House, Clocktower Hill. A replacement projector bulb. Tonight is their first show in years.",
      "speaker": "harpreet"
    },
    "paperTaken": {
      "text": "A square of coloured paper. Too cheerful to leave behind.",
      "speaker": "harpreet"
    },
    "pencilTaken": {
      "text": "A pencil. Every delivery needs a little paperwork.",
      "speaker": "harpreet"
    },
    "pinwheelMade": {
      "text": "A fold, a twist, and a pencil for a handle. One extremely advanced wind-powered spaceship.",
      "speaker": "harpreet"
    },
    "courtyardFirst": {
      "text": "The rain has stopped. Unfortunately, my scooter seems to have taken the evening off.",
      "speaker": "harpreet"
    },
    "scooterBroken": {
      "text": "A loose battery terminal, and an empty headlight fuse holder. Meena will know where to find a spanner.",
      "speaker": "harpreet"
    },
    "needParcel": {
      "text": "I should collect the parcel upstairs before heading out.",
      "speaker": "harpreet"
    },
    "needLabel": {
      "text": "I need a readable address before choosing a road.",
      "speaker": "harpreet"
    },
    "needCable": {
      "text": "That loose terminal is still stopping the engine.",
      "speaker": "harpreet"
    },
    "needFuse": {
      "text": "The engine is ready, but the hill road will be dark. I still need the headlight fuse.",
      "speaker": "harpreet"
    },
    "flood": {
      "text": "The underpass is flooded. The high road past the clocktower should still be open.",
      "speaker": "harpreet"
    },
    "kabirHello": {
      "text": "Captain Kabir reporting! I found a tiny space crystal beside your scooter. It fits perfectly in my spaceship.",
      "speaker": "kabir",
      "choices": [
        {
          "label": "Ask about the crystal",
          "event": "ask:crystal"
        },
        {
          "label": "Ask about the Picture House",
          "event": "ask:picture"
        }
      ]
    },
    "crystal": {
      "text": "It is your fuse? Oh. Can we trade? Something that spins, or something warm. Space is surprisingly cold.",
      "speaker": "kabir"
    },
    "picture": {
      "text": "The blue lantern on the hill! Mum says the cinema opens tonight, if the projector works. Are you taking its missing bit?",
      "speaker": "kabir"
    },
    "kabirAfter": {
      "text": "A real film on a giant screen! Save me a seat near the front.",
      "speaker": "kabir"
    },
    "pinwheelTrade": {
      "text": "Whoa! A wind engine! Definitely an upgrade. Here is your little glass fuse, captain.",
      "speaker": "kabir"
    },
    "chaiTrade": {
      "text": "Warm chai! That is much better than a cold space crystal. Here, your fuse.",
      "speaker": "kabir"
    },
    "fuseFit": {
      "text": "The fuse clicks into place. That should take care of the headlight.",
      "speaker": "harpreet"
    },
    "meenaHello": {
      "text": "Last delivery, Harpreet? You have that one-more-problem face. What has the scooter done now?",
      "speaker": "meena",
      "choices": [
        {
          "label": "The battery terminal is loose",
          "event": "ask:tools"
        },
        {
          "label": "Who is waiting for this parcel?",
          "event": "ask:cinema"
        }
      ]
    },
    "tools": {
      "text": "Take the spanner from my tool roll. Tighten the terminal, gently. And have a chai if you need one.",
      "speaker": "meena"
    },
    "cinema": {
      "text": "The Picture House has been dark for years. Tonight, the owner promised a free show. Without that bulb, it stays a promise.",
      "speaker": "meena"
    },
    "wrenchTaken": {
      "text": "Just the size I need. I will bring it back tomorrow.",
      "speaker": "harpreet"
    },
    "chaiTaken": {
      "text": "One warm chai. Meena always makes an extra.",
      "speaker": "harpreet"
    },
    "repair": {
      "text": "A quarter turn. A snug connection. Let us hear that engine again.",
      "speaker": "harpreet"
    },
    "radio": {
      "text": "The radio says more rain is coming. We have a little time, but not the whole evening.",
      "speaker": "harpreet"
    },
    "poster": {
      "text": "Tonight: the return of the Old Picture House. Doors open at dusk. Someone has drawn a little blue lantern beside the address.",
      "speaker": "harpreet"
    },
    "ready": {
      "text": "Parcel safe. Engine running. Headlight on. Now, which way to the Picture House?",
      "speaker": "harpreet",
      "choices": [
        {
          "label": "Take the underpass",
          "event": "route:underpass"
        },
        {
          "label": "Climb Clocktower Hill",
          "event": "route:hill"
        }
      ]
    },
    "wrongRoad": {
      "text": "Water right across the underpass. No delivery is worth losing the scooter. We will take the hill.",
      "speaker": "harpreet"
    },
    "road": {
      "text": "Come on, old friend. One more climb. There is a whole audience waiting for us.",
      "speaker": "harpreet"
    },
    "arrival": {
      "text": "A blue lantern. A locked door. Then footsteps from inside. I think we made it.",
      "speaker": "harpreet"
    },
    "delivered": {
      "text": "The bulb is in. The projector is turning. Sometimes a small parcel carries a whole evening.",
      "speaker": "harpreet"
    },
    "finalKid": {
      "text": "You did it! Look, the screen is lighting up!",
      "speaker": "kabir"
    },
    "cantCombine": {
      "text": "That does not help here. Let me look at what this actually needs.",
      "speaker": "harpreet"
    },
    "alreadyDry": {
      "text": "The address is clear now: Old Picture House, Clocktower Hill.",
      "speaker": "harpreet"
    },
    "alreadyFixed": {
      "text": "The cable is secure. No need to keep tightening it.",
      "speaker": "harpreet"
    },
    "saveResume": {
      "text": "Back to the last delivery. The neighbourhood is still waiting.",
      "speaker": "harpreet"
    }
  },
  "rules": [
    {
      "when": "click:scooter",
      "in": "courtyard",
      "if": "!scooterInspected+!cableFixed+!fuseInstalled",
      "actions": [
        "flag:scooterInspected",
        "message:scooterBroken"
      ]
    },
    {
      "when": "click:parcel",
      "actions": [
        "inventory:parcel",
        "sequence:collectParcel"
      ],
      "if": "!inventory.parcel",
      "in": "home"
    },
    {
      "when": "click:lamp",
      "actions": [
        "message:lamp"
      ],
      "in": "home"
    },
    {
      "when": "click:note",
