  "dialogues": {
    "welcome": {
      "text": "The festival starts soon! My kite has a torn wing and no string. Could you help me make it fly?",
      "choices": [
        {
          "label": "Show me what to fix",
          "message": "firstHint"
        },
        {
          "label": "Inspect the kite",
          "event": "click:kite"
        }
      ]
    },
    "firstHint": {
      "text": "See the coloured patch paper and the spool on the bench? Use the paper on the kite first, then add thread. Drag or tap-to-combine both ways."
    },
    "kiteTorn": {
      "text": "Oh no, there’s a rip along the left wing. A little coloured paper should patch it."
    },
    "kitePatched": {
      "text": "That patch looks splendid! But we still need a tail of cotton thread before the kite can fly."
    },
    "kiteTied": {
      "text": "Look at that! Good as new. Now let’s get some wind on the rooftop.",
      "choices": [
        {
          "label": "Climb to the roof →",
          "scene": "rooftop"
        }
      ]
    },
    "kiteReadyInShop": {
      "text": "Perfect! Patch and string are ready. The roof is through the door on the right.",
      "choices": [
        {
          "label": "Take the stairs",
          "scene": "rooftop"
        }
      ]
    },
    "paperTaken": {
      "text": "Bright orange repair paper! Tap the kite to attach it, or drag the paper from your pocket onto it."
    },
    "threadTaken": {
      "text": "A strong cotton thread. We’ll tie it onto the kite after we patch the tear."
    },
    "needPatch": {
      "text": "The thread will pull through that tear. Use the coloured patch paper first."
    },
    "paperAlready": {
      "text": "This kite is already patched. Now it needs thread."
    },
    "needString": {
      "text": "Almost! The kite needs thread. There’s a spool on the bench."
    },
    "stillBroken": {
      "text": "Let’s fix the kite before heading up. The paper is on the left of the bench, and the spool is on the right."
    },
    "roofEarly": {
      "text": "It’s breezy out here, but the kite still needs repairs. Go back down and finish it.",
      "choices": [
        {
          "label": "Back to the workshop",
          "scene": "workshop"
        }
      ]
    },
    "roofWelcome": {
      "text": "What a beautiful sky! Put the kite on the chalk circle, then check which way the wind is blowing."
    },
    "roofKite": {
      "text": "The kite feels lighter already. Tap the chalk circle to place it, or drag it there."
    },
    "launchPadEmpty": {
      "text": "The chalk circle marks the safest place to launch. Carry the repaired kite onto it."
    },
    "launchPadReady": {
      "text": "The kite is set! Now touch the weather vane and choose the gentler breeze.",
      "choices": [
        {
          "label": "Check the weather vane",
          "event": "click:weatherVane"
        }
      ]
    },
    "windBefore": {
      "text": "The vane is spinning. Place the repaired kite on the chalk circle first so we can test the wind."
    },
    "windQuestion": {
      "text": "The wind is changing. Which breeze should we use?",
      "choices": [
        {
          "label": "The roaring WEST gust ↙",
          "event": "choose:west"
        },
        {
          "label": "The gentle EAST breeze ↗",
          "event": "choose:east"
        }
      ]
    },
    "badWind": {
      "text": "WHOOSH! That gust nearly took my turban! Too strong for a little kite. Shall we try the gentle breeze?",
      "choices": [
        {
          "label": "Try the gentle east breeze",
          "event": "choose:east"
        },
        {
          "label": "Check the weather vane again",
          "event": "click:weatherVane"
        }
      ]
    },
    "goodWind": {
      "text": "That’s it. A soft, steady breeze! The kite is ready. Press LAUNCH!",
      "choices": [
        {
          "label": "Launch the kite ✦",
          "event": "click:launch"
        }
      ]
    },
    "launchBlocked": {
      "text": "We need a mended, tied kite in the chalk circle and a gentle breeze before we launch."
    },
    "skyIntro": {
      "text": "Ready, Harpreet? One… two… three… LET GO!"
    },
    "skyDone": {
      "text": "Look at those colours! We did it. The whole neighbourhood can see our kite now!"
    },
    "character": {
      "text": "Come on, partner! Let’s get this kite in the air together."
    },
    "bell": {
      "text": "Ting! The little shop bell sounds just like the start of festival day."
    },
    "cantCombine": {
      "text": "Those don’t fit together just yet. Try the patch on the kite, then the cotton thread."
    },
    "badDrop": {
      "text": "Try dropping the item on its destination — or select it and tap the target."
    }
  },
  "rules": [
    {
      "when": "click:character",
      "actions": [
        "message:character"
      ]
    },
    {
