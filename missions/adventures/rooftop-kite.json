  "hints": [
    {
      "if": "!patched+scene.workshop",
      "text": "Tap the orange paper patch on the bench, then tap the torn kite. Or drag the paper onto it."
    },
    {
      "if": "!patched+scene.rooftop",
      "text": "The kite needs a coloured paper patch. Go back down the stairs."
    },
    {
      "if": "!tied+scene.workshop",
      "text": "Tap the spool at the right end of the bench, then tap the kite to attach the string."
    },
    {
      "if": "!tied+scene.rooftop",
      "text": "Go down to the workshop and tie thread from the spool onto the patched kite."
    },
    {
      "if": "!positioned",
      "text": "On the roof, select the kite then select the chalk launch circle. You can also drag the kite onto it."
    },
    {
      "if": "!steady",
      "text": "Tap the weather vane at the right of the roof, then choose the gentle east breeze."
    },
    {
      "text": "Tap the green LAUNCH button near the chalk circle."
    }
  ],
