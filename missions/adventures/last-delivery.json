      ],
      "in": "courtyard"
    },
    {
      "when": "click:kabir",
      "actions": [
        "message:kabirAfter"
      ],
      "if": "fuseFound",
      "in": "courtyard"
    },
    {
      "when": "click:kabir",
      "actions": [
        "message:kabirHello"
      ],
      "in": "courtyard"
    },
    {
      "when": "ask:crystal",
